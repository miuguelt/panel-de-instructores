# Copie este archivo a .env y complete los valores. NUNCA versione .env.

FLASK_ENV=development
FLASK_DEBUG=true

# Obligatorio en produccion: valor aleatorio largo (ej: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# --- Base de datos ---
# Desarrollo nativo Windows (PostgreSQL local 5434):
DATABASE_URL=postgresql://adso:CAMBIAR_PASSWORD@127.0.0.1:5434/adso_control
# Docker Compose: deje DATABASE_URL vacio y use DB_* (el compose arma la URL con host "db").
DB_HOST=db
DB_PORT=5432
DB_USER=adso
DB_NAME=adso_control
DB_PASSWORD=

# --- Admin inicial (se crea al arrancar si no existe; sin password NO se crea) ---
ADSO_ADMIN_EMAIL=admin@sena.edu.co
ADSO_ADMIN_NOMBRE=Administrador
ADSO_ADMIN_PASSWORD=

# --- Rate limiting (memory:// si no hay Redis) ---
REDIS_URL=memory://

# --- App ---
PORT=8009
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# Opcional: correo de avisos. En la interfaz permanece desactivado hasta marcarlo por ficha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
