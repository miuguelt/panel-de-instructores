# ==========================================================================
# .env.example — Panel de Instructores ADSO
# Copie este archivo a .env y complete los valores. NUNCA versione .env.
#
# ── COOLIFY (producción) ────────────────────────────────────────────────
# NO usar este archivo en Coolify. Definir las variables directamente en:
#   Coolify UI → Application → Environment Variables
#
# ⚠️  REGLA DE $ EN VALORES:
#   Si algún valor contiene el carácter $, Docker Compose lo interpreta
#   como variable de shell y lo corrompe. En este proyecto el compose NO
#   usa ${VAR} para ninguna variable sensible — Coolify las inyecta
#   directamente al contenedor sin pasar por la capa de interpolación.
#   No es necesario escapar $ con $$ si se usa la UI de Coolify.
# ==========================================================================

FLASK_ENV=development
FLASK_DEBUG=true

# ── Seguridad ──────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(64))"
# (solo letras y números: 0-9 a-f — sin $ ni caracteres especiales)
SECRET_KEY=

# ── Base de datos ──────────────────────────────────────────────────────
# URL completa de conexión. En Coolify, definir como variable de entorno
# directamente en la UI. Sin ${} ni $$ necesario.
# Driver: psycopg2 (es el único instalado en requirements.txt). NO usar
# "postgresql+psycopg://" (psycopg 3) — SQLAlchemy falla con ModuleNotFoundError.
DATABASE_URL=postgresql+psycopg2://adso:CAMBIAR_PASSWORD@127.0.0.1:5434/adso_control

# Opción Docker — variables individuales (solo si el entrypoint construye la URL):
# DB_HOST=db
# DB_PORT=5432
# DB_USER=adso
# DB_NAME=adso_control
# DB_PASSWORD=

# ── Admin inicial ──────────────────────────────────────────────────────
ADSO_ADMIN_EMAIL=admin@sena.edu.co
ADSO_ADMIN_NOMBRE=Administrador
ADSO_ADMIN_PASSWORD=

# ── Redis (opcional — memory:// si no hay Redis) ───────────────────────
# En produccion (Coolify) usar el alias UNICO del servicio Redis, no `redis`:
# la red `coolify` es compartida entre stacks y varios contenedores pueden
# registrar el alias `redis`, lo que hace que el DNS reparta round-robin entre
# Redis distintos y la autenticacion falle de forma intermitente.
#   REDIS_URL=redis://:LA_PASSWORD@redis-adso:6379/0
REDIS_URL=memory://

# En producción Coolify debe usar Redis real: el worker procesa los XLS fuera
# de Gunicorn. En local puede dejarse false para procesar sincrónicamente.
IMPORTACIONES_ASINCRONAS=true
IMPORT_QUEUE_NAME=adso:importaciones

# ── App ────────────────────────────────────────────────────────────────
PORT=8009
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# ── SMTP (opcional) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
